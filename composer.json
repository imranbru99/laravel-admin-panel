{
    "name": "imrandevbd/laravel-admin-panel",
    "description": "The all-in-one, AI-powered Laravel admin panel. Beautiful light and dark UI, fluent CRUD, RBAC, widgets, media, audit logs and a headless API, installed in under 3 minutes.",
    "keywords": [
        "laravel",
        "laravel-package",
        "laravel-admin",
        "admin-panel",
        "dashboard",
        "admin-dashboard",
        "crud",
        "rbac",
        "tailwindcss",
        "alpinejs",
        "dark-mode",
        "headless-api",
        "ai",
        "filament-alternative"
    ],
    "homepage": "https://github.com/imranbru99/laravel-admin-panel",
    "license": "MIT",
    "authors": [
        {
            "name": "Imran Hossain",
            "email": "imrandevbd@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/session": "^11.0|^12.0",
        "illuminate/auth": "^11.0|^12.0",
        "illuminate/events": "^11.0|^12.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "ImranDevBD\\LaravelAdminPanel\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ImranDevBD\\LaravelAdminPanel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ImranDevBD\\LaravelAdminPanel\\AdminPanelServiceProvider"
            ],
            "aliases": {
                "AdminPanel": "ImranDevBD\\LaravelAdminPanel\\Facades\\AdminPanel"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
